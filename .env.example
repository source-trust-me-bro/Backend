# Copy this file to .env and fill in real values.
APP_NAME=multilingual-news
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=multilingual_news
MONGODB_TIMEOUT_MS=5000

# Clerk Authentication Settings
# Get these from the Clerk dashboard. The backend only needs the issuer (or an
# explicit JWKS URL) plus the publishable key used by the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional: override the derived JWKS endpoint.
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWKS_CACHE_SECONDS=300

NEWS_LANGUAGES=en,fi,sv
DEFAULT_LANGUAGE=en
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# Set to true only after installing sentence-transformers (see README).
ENABLE_SENTENCE_TRANSFORMERS=false

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Ingestion and search tuning
INGESTION_MAX_ITEMS=20
FETCH_ARTICLE_CONTENT=true
MAX_CONTENT_CHARS=20000
HTTP_TIMEOUT_SECONDS=15
SEARCH_MAX_TOKENS=8
SEMANTIC_CANDIDATE_LIMIT=500
FEED_USER_AGENT=MultilingualNewsBot/1.0 (+https://example.com/bot)
STARTUP_DB_CHECK=true
